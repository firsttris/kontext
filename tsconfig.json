{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun", "vite/client", "vite-plugin-pwa/react"],
    "paths": { "@/*": ["./src/*"] }
  },
  "exclude": ["src/sw"],
  "include": [
    "src",
    "dev",
    "e2e",
    "server",
    "box",
    "video",
    "deploy",
    "vite.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts"
  ]
}
