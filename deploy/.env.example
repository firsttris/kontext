# The address of Kontext in the browser
KONTEXT_DOMAIN=kontext.weber-haustechnik.de
# The mail server's name (MX record, reverse DNS of the server's IP)
STALWART_HOSTNAME=mail.weber-haustechnik.de
# The mail domain: Caddy serves https://mta-sts.<it> (MTA-STS) and https://openpgpkey.<it> (WKD)
MAIL_DOMAIN=weber-haustechnik.de
# For Let's Encrypt
ACME_EMAIL=admin@teufel-it.de
# The server's Tailscale address: Stalwart's own admin listens there on port 8080
TAILSCALE_IP=100.64.0.10
# Signs the sessions and encrypts Stalwart's tokens: `openssl rand -base64 48`
KONTEXT_SECRET=change-me-to-48-random-characters
# Firmenverwaltung: API key ("API_…") of Stalwart's account kontext-server (docs/installation.md)
STALWART_ADMIN_KEY=
# Image tag of tristanteu/kontext: a fixed version, raised by hand for an update (never "latest",
# so a new image never runs unannounced)
KONTEXT_VERSION=0.1.3
# Calls in the chat and telephony (LiveKit, LiveKit SIP): `openssl rand -base64 48`; without
# "calls" in COMPOSE_PROFILES and the secret there are none. "documents" adds Schreibzeug (below).
COMPOSE_PROFILES=calls,documents
LIVEKIT_SECRET=change-me-to-48-random-characters
# Documents (Schreibzeug): its own address (DNS like KONTEXT_DOMAIN), and the secret it signs in
# to Kontext with: `openssl rand -base64 48`. Without "documents" remove both lines.
SCHREIBZEUG_URL=https://dokumente.weber-haustechnik.de
SCHREIBZEUG_CLIENT_SECRET=change-me-to-48-random-characters
# Image tag of tristanteu/schreibzeug: best a fixed version as well
SCHREIBZEUG_VERSION=0.1.4

# Backups (deploy/backup.sh): Restic repository on S3 with Object Lock
RESTIC_REPOSITORY=s3:https://s3.eu-central-1.example.com/kontext-weber
RESTIC_PASSWORD=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
