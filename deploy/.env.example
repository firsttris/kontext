# The address of Kontext in the browser
KONTEXT_DOMAIN=kontext.weber-haustechnik.de
# The mail server's name (MX record, reverse DNS of the server's IP)
STALWART_HOSTNAME=mail.weber-haustechnik.de
# For Let's Encrypt
ACME_EMAIL=admin@teufel-it.de
# The server's Tailscale address: Stalwart's own admin listens there on port 8080
TAILSCALE_IP=100.64.0.10
# Signs the sessions and encrypts Stalwart's tokens: `openssl rand -base64 48`
KONTEXT_SECRET=change-me-to-48-random-characters
# Firmenverwaltung: API key ("API_…") of Stalwart's account kontext-server (docs/installation.md)
STALWART_ADMIN_KEY=
# Image tag of tristanteu/kontext
KONTEXT_VERSION=latest
# Calls in the chat (LiveKit): `openssl rand -base64 48`; leave both empty to go without calls
COMPOSE_PROFILES=calls
LIVEKIT_SECRET=change-me-to-48-random-characters

# Backups (deploy/backup.sh): Restic repository on S3 with Object Lock
RESTIC_REPOSITORY=s3:https://s3.eu-central-1.example.com/kontext-weber
RESTIC_PASSWORD=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
