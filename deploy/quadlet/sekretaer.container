# Podman Quadlet: copy to /etc/containers/systemd/ and run `systemctl daemon-reload`.
# The app and its server (sign-in, JMAP to Stalwart). Set BETTER_AUTH_URL and BETTER_AUTH_SECRET
# in /opt/sekretaer/deploy/sekretaer.env (Quadlet does not expand variables).
[Unit]
Description=Sekretär (app and server)
After=stalwart.service
Wants=stalwart.service

[Container]
Image=docker.io/tristanteu/sekretaer:latest
ContainerName=sekretaer
Network=sekretaer.network
Volume=sekretaer-data:/data
Environment=STALWART_URL=http://stalwart:8080
EnvironmentFile=/opt/sekretaer/deploy/sekretaer.env
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
