# Podman Quadlet: copy to /etc/containers/systemd/ and run `systemctl daemon-reload`.
# The app and its server (sign-in, JMAP to Stalwart). Set BETTER_AUTH_URL, BETTER_AUTH_SECRET,
# (for the Firmenverwaltung) STALWART_ADMIN_KEY, (for calls, with livekit.container)
# LIVEKIT_API_SECRET and (for documents, with schreibzeug.container) SCHREIBZEUG_URL and
# SCHREIBZEUG_CLIENT_SECRET in /opt/kontext/deploy/kontext.env (Quadlet does not expand variables).
[Unit]
Description=Kontext (app and server)
After=stalwart.service
Wants=stalwart.service

[Container]
# A fixed version, raised by hand (docs/installation.md, Updates); no automatic updates.
Image=docker.io/tristanteu/kontext:0.1.6
ContainerName=kontext
Network=kontext.network
Volume=kontext-data:/data
Environment=STALWART_URL=http://stalwart:8080
Environment=LIVEKIT_URL=http://livekit:7880
Environment=LIVEKIT_API_KEY=kontext
EnvironmentFile=/opt/kontext/deploy/kontext.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
