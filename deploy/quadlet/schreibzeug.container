# Podman Quadlet: copy to /etc/containers/systemd/ and run `systemctl daemon-reload`.
# Documents (Schreibzeug), signed in through Kontext. Set SCHREIBZEUG_URL (its address),
# SCHREIBZEUG_EMBED_ORIGIN (https://<KONTEXT_DOMAIN>), OIDC_ISSUER (https://<KONTEXT_DOMAIN>/api/auth)
# and OIDC_CLIENT_SECRET (Kontext's SCHREIBZEUG_CLIENT_SECRET) in
# /opt/kontext/deploy/schreibzeug.env (Quadlet does not expand variables).
[Unit]
Description=Schreibzeug (documents for Kontext)
After=kontext.service
Wants=kontext.service

[Container]
Image=docker.io/tristanteu/schreibzeug:0.1.8
ContainerName=schreibzeug
Network=kontext.network
Volume=schreibzeug-data:/data
Environment=OIDC_CLIENT_ID=schreibzeug
# Caddy, as Schreibzeug sees it (kontext.network), so sign-ins count per client, not as Caddy's
Environment=SCHREIBZEUG_TRUSTED_PROXIES=10.89.250.0/24
EnvironmentFile=/opt/kontext/deploy/schreibzeug.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
