# Podman Quadlet: copy to /etc/containers/systemd/ and run `systemctl daemon-reload`.
[Unit]
Description=Caddy (HTTPS for Sekretär)
After=sekretaer.service
Wants=sekretaer.service

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=caddy
Network=sekretaer.network
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
Volume=/opt/sekretaer/deploy/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=caddy-data:/data
Volume=caddy-config:/config
EnvironmentFile=/opt/sekretaer/deploy/.env
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
