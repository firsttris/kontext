# Podman Quadlet: copy to /etc/containers/systemd/ and run `systemctl daemon-reload`.
[Unit]
Description=Caddy (HTTPS for Kontext)
After=kontext.service
Wants=kontext.service

[Container]
Image=docker.io/library/caddy:2.10.2-alpine
ContainerName=caddy
Network=kontext.network
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp
Volume=/opt/kontext/deploy/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=caddy-data:/data
Volume=caddy-config:/config
# Only what the Caddyfile reads, not deploy/.env with Kontext's secrets and the backup's keys
Environment=KONTEXT_DOMAIN=kontext.firma.de
Environment=ACME_EMAIL=admin@firma.de
Environment=SCHREIBZEUG_URL=https://dokumente.firma.de

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
