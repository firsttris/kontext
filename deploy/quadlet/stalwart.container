# Podman Quadlet: copy to /etc/containers/systemd/ and run `systemctl daemon-reload`.
[Unit]
Description=Stalwart mail server (Kontext)

[Container]
Image=docker.io/stalwartlabs/stalwart:v1.1.0
ContainerName=stalwart
Network=kontext.network
PublishPort=25:25
PublishPort=465:465
PublishPort=587:587
PublishPort=993:993
# Stalwart's own admin, only on the server itself (reach it with `ssh -L 8080:127.0.0.1:8080`);
# or put the server's Tailscale address here (Quadlet does not expand variables)
PublishPort=127.0.0.1:8080:8080
Volume=stalwart-config:/etc/stalwart
Volume=stalwart-data:/var/lib/stalwart
# Hardened: read-only except the volumes above (/tmp Podman mounts as tmpfs itself with ReadOnly),
# no new privileges, no capabilities but NET_BIND_SERVICE for the mail ports, which Stalwart (uid
# 2000) binds through a file capability on its binary (docs/installation.md, Hardening)
ReadOnly=true
DropCapability=ALL
AddCapability=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# Only what Stalwart needs, not deploy/.env with Kontext's secrets and the backup's keys
Environment=STALWART_HOSTNAME=mail.firma.de
Environment=STALWART_PUBLIC_URL=https://kontext.firma.de
# The key that encrypts mails and files in the storage (STALWART_BLOB_KEY=…, chmod 600;
# docs/installation.md): never change or lose it once set, Stalwart cannot read them without it
#EnvironmentFile=/opt/kontext/deploy/stalwart.env
HealthCmd=curl -fsS http://127.0.0.1:8080/healthz/live

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
