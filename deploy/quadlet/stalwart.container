# Podman Quadlet: copy to /etc/containers/systemd/ and run `systemctl daemon-reload`.
[Unit]
Description=Stalwart mail server (Kontext)

[Container]
Image=docker.io/stalwartlabs/stalwart:v1.0.1
ContainerName=stalwart
Network=kontext.network
PublishPort=25:25
PublishPort=465:465
PublishPort=587:587
PublishPort=993:993
# Stalwart's own admin, only on the server itself (reach it with `ssh -L 8080:127.0.0.1:8080`);
# or put the server's Tailscale address here (Quadlet does not expand variables)
PublishPort=127.0.0.1:8080:8080
Volume=stalwart-config:/etc/stalwart
Volume=stalwart-data:/var/lib/stalwart
# Only what Stalwart needs, not deploy/.env with Kontext's secrets and the backup's keys
Environment=STALWART_HOSTNAME=mail.firma.de
Environment=STALWART_PUBLIC_URL=https://kontext.firma.de
HealthCmd=curl -fsS http://127.0.0.1:8080/healthz/live

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
