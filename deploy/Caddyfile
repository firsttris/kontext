# One customer = one server: Kontext on https://$KONTEXT_DOMAIN.
# Caddy gets the certificate; the app, sign-in and JMAP go to the Kontext server, which talks to
# Stalwart. Mail clients reach Stalwart directly on the mail ports and through /dav and autoconfig.
# With documents, Schreibzeug has an address of its own ($SCHREIBZEUG_URL, e.g.
# https://dokumente.firma.de): the same site as Kontext, so its frame and cookies need no detour.
{
	email {$ACME_EMAIL}
}

{$KONTEXT_DOMAIN} {
	# The live streams (Kontext's /api/live, Stalwart's JMAP push) uncompressed: a compressor
	# may hold events back until its buffer is full.
	@compressible not path /api/live /jmap/eventsource*
	encode @compressible zstd gzip

	# CalDAV/CardDAV and autoconfiguration for mail programs and phones, straight to Stalwart;
	# the OAuth discovery for agents (MCP, RFC 9728 / 8414) belongs to Kontext
	@stalwart {
		path /.well-known/* /dav/* /mail/config-v1.1.xml /autodiscover/*
		not path /.well-known/oauth-protected-resource* /.well-known/oauth-authorization-server*
	}
	handle @stalwart {
		reverse_proxy stalwart:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Calls: LiveKit's signalling (WebSocket); the media go to it directly (TCP 7881, UDP 7882)
	handle /rtc* {
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy kontext:3000 {
			header_up X-Forwarded-For {remote_host}
			flush_interval -1
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Camera, microphone and the screen only for Kontext itself (calls in the chat)
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=()"
		# Only where the answer brings none: the server sets the app's own (server/headers.ts), and
		# its downloads and chat files bring "sandbox", which this must not replace.
		?Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; frame-src 'self' blob: {$SCHREIBZEUG_URL:https://schreibzeug.internal}; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}

# Schreibzeug (the module "Dokumente"). Without SCHREIBZEUG_URL the placeholder answers nobody and
# gets no public certificate (.internal). Schreibzeug sets which site may frame it (Kontext's).
{$SCHREIBZEUG_URL:https://schreibzeug.internal} {
	encode zstd gzip

	handle {
		reverse_proxy schreibzeug:3000 {
			flush_interval -1
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
