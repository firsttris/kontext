# One customer = one server: Sekretär on https://$SEKRETAER_DOMAIN.
# Caddy gets the certificate; the app, sign-in and JMAP go to the Sekretär server, which talks to
# Stalwart. Mail clients reach Stalwart directly on the mail ports and through /dav and autoconfig.
{
	email {$ACME_EMAIL}
}

{$SEKRETAER_DOMAIN} {
	encode zstd gzip

	# CalDAV/CardDAV and autoconfiguration for mail programs and phones, straight to Stalwart
	@stalwart path /.well-known/* /dav/* /mail/config-v1.1.xml /autodiscover/*
	handle @stalwart {
		reverse_proxy stalwart:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		reverse_proxy sekretaer:3000 {
			header_up X-Forwarded-For {remote_host}
			flush_interval -1
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; frame-src 'self' blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}
