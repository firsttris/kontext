# One customer = one server: Sekretär on https://$SEKRETAER_DOMAIN, Stalwart behind it.
# Caddy gets the certificate; the mail ports (25, 465, 587, 993) go straight to Stalwart.
# Stalwart's own admin (port 8080) is not published here, only on the Tailscale address.
{
	email {$ACME_EMAIL}
}

{$SEKRETAER_DOMAIN} {
	encode zstd gzip

	# JMAP (mail, calendar, contacts), the event stream, CalDAV/CardDAV and autoconfig
	@stalwart path /jmap /jmap/* /.well-known/* /dav/* /auth/* /mail/config-v1.1.xml /autodiscover/*
	handle @stalwart {
		reverse_proxy {$STALWART_UPSTREAM:stalwart:8080} {
			header_up X-Forwarded-For {remote_host}
			flush_interval -1
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; frame-src 'self' blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}
