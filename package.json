{
  "name": "kontext",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "description": "Kontext – self-hosted office suite for small businesses on top of Stalwart",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bun dev/dev.ts",
    "dev:app": "vite",
    "dev:stalwart": "bun dev/stalwart.ts",
    "seed": "bun dev/seed.ts",
    "icons": "bun dev/icons.ts",
    "build": "vite build && bun dev/precompress.ts dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "bun run build && E2E_BUILT=1 playwright test --project=desktop --project=phone --project=pwa",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy custom-choice preferredLanguage baseLocale",
    "screenshots": "playwright test --project=screenshots",
    "video": "bun run video:de && bun run video:en",
    "video:de": "FILM_LANG=de bun run video:film",
    "video:en": "FILM_LANG=en bun run video:film",
    "video:film": "bun run video:record && bun run video:render",
    "video:record": "playwright test --project=video",
    "video:render": "bun video/render.ts",
    "dev:server": "bun --watch server/main.ts",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.13",
    "@better-auth/mcp": "1.7.13",
    "@better-auth/oauth-provider": "1.7.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@livekit/components-react": "^2.9.24",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.22",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-auth": "1.7.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "imapflow": "^1.7.8",
    "jose": "^6.2.13",
    "livekit-client": "^2.23.0",
    "lucide-react": "^1.61.0",
    "node-forge": "1.4.0",
    "nodemailer": "^10.2.1",
    "openpgp": "6.3.2",
    "postal-mime": "2.7.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.2",
    "@inlang/paraglide-js": "^2.29.1",
    "@inlang/plugin-message-format": "^4.5.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/imapflow": "^1.0.23",
    "@types/node-forge": "1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
