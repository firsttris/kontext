// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new release of
// the images Kontext runs with and the Bun it is built with, plus the "Dependency Dashboard" issue
// listing what is open. CI also checks the packages with `bun audit`.
// Everything else (the other packages, the actions, the images) comes with the shared settings of
// firsttris/workflows (renovate/default.json5): minor and patch updates once a month in one pull
// request that merges itself when CI is green, majors on request in the dashboard.
// Check with `bunx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>firsttris/workflows//renovate/default.json5"],
  customManagers: [
    {
      // The local Stalwart and LiveKit of dev and CI (dev/stalwart.ts, dev/livekit.ts) are the
      // same releases as the images in deploy/, so a new one is tested by the e2e run of its PR.
      // The images' tags carry a "v", these constants do not.
      customType: "regex",
      managerFilePatterns: ["/^dev/config\\.ts$/"],
      matchStrings: [
        'STALWART_VERSION = "(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: "docker.io/stalwartlabs/stalwart",
      datasourceTemplate: "docker",
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^dev/config\\.ts$/"],
      matchStrings: [
        'LIVEKIT_VERSION = "(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: "docker.io/livekit/livekit-server",
      datasourceTemplate: "docker",
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
    {
      // The Bun of the workflows (setup-bun and the screenshots' npm install, newest patch of a
      // minor), the same minor as the images in docker/ and box/
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "bun-version: (?<currentValue>\\d+\\.\\d+)\\.x",
        "bun@(?<currentValue>\\d+\\.\\d+)\\.x",
      ],
      depNameTemplate: "oven-sh/bun",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^bun-v(?<version>\\d+\\.\\d+)\\.\\d+$",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)$",
    },
    {
      // The Bun image ci.yml runs the box agent's build in (docker run, not seen by the
      // dockerfile manager)
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/ci\\.yml$/"],
      matchStrings: ["docker\\.io/oven/bun:(?<currentValue>\\d+\\.\\d+-alpine)"],
      depNameTemplate: "docker.io/oven/bun",
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      // From the Bun packages only @types/bun (with Bun below)
      matchManagers: ["bun"],
      matchPackageNames: ["!@types/bun"],
      enabled: false,
    },
    {
      // The images of docker/ and box/, ci.yml, the bun-version of the workflows and the types in
      // one PR, so the Bun Kontext is built, tested and shipped with cannot drift apart
      matchPackageNames: ["docker.io/oven/bun", "oven-sh/bun", "@types/bun"],
      groupName: "Bun",
      sourceUrl: "https://github.com/oven-sh/bun",
      prBodyNotes: [
        "The image of Kontext (docker/Dockerfile) and of the box (box/Dockerfile, also run in ci.yml), `bun-version` of CI, docs, screenshots and video, and `@types/bun` move together. Before merging: read the Bun release notes; CI runs `bun audit`, the tests, the e2e suite and the image check with the new Bun.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // Kontext's own images move with its releases (release.yml), Schreibzeug with its own
      matchPackageNames: ["docker.io/tristanteu/**"],
      enabled: false,
    },
    {
      // One PR for dev/config.ts, compose.yaml and the Quadlet unit, so they cannot drift apart
      matchPackageNames: ["docker.io/stalwartlabs/stalwart"],
      groupName: "Stalwart",
      sourceUrl: "https://github.com/stalwartlabs/stalwart",
      prBodyNotes: [
        "Before merging: read Stalwart's `CHANGELOG.md` and, for a new minor or major, `UPGRADING/`. The workarounds and probes marked with a Stalwart version in the code (`git grep -n 'Stalwart [01]\\.'`) may no longer be needed or may have changed. A new major may need a data migration on the customers' servers (see docs/installation.md, Updates). The e2e run of this PR uses the new release.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      matchPackageNames: ["docker.io/livekit/livekit-server"],
      groupName: "LiveKit",
      sourceUrl: "https://github.com/livekit/livekit",
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      matchPackageNames: ["docker.io/livekit/sip"],
      sourceUrl: "https://github.com/livekit/sip",
    },
  ],
}
